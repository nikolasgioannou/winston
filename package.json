{
  "name": "winston",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @winston/db db:generate",
    "db:migrate": "bun run --filter @winston/db db:migrate",
    "db:seed": "bun run --filter @winston/db db:seed",
    "db:up": "docker compose up --detach --wait postgres",
    "dev": "bun scripts/dev.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "model:smoke": "bun run --filter @winston/agents model:smoke",
    "prepare": "lefthook install",
    "telegram:webhook": "bun run --filter @winston/api telegram:webhook",
    "test": "bun test --env-file=.env.local",
    "tunnel": "bun scripts/tunnel.ts",
    "typecheck": "tsc && bun run --filter '*' --if-present typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@winston/shared": "workspace:*",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.9",
    "prettier-plugin-packagejson": "3.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "zod": "4.6.5"
  }
}
