{
  "name": "winston",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './apps/*' build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:tooling",
    "dev": "bun run --filter @winston/web dev",
    "format": "sort-package-json 'package.json' 'apps/*/package.json' 'packages/*/package.json' && prettier . --write --ignore-path .gitignore --ignore-path .git/info/exclude",
    "format:check": "sort-package-json 'package.json' 'apps/*/package.json' 'packages/*/package.json' --check && prettier . --check --ignore-path .gitignore --ignore-path .git/info/exclude && node scripts/check-text.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test:tooling": "node --test scripts/tooling.test.mjs",
    "typecheck": "bun run --filter './apps/*' typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "sort-package-json": "4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": ">=22.12.0"
  }
}
