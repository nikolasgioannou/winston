{
  "name": "@winston/db",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./config": "./src/config.ts",
    "./ids": "./src/ids.ts",
    "./connections": "./src/connections.ts",
    "./testing": "./src/testing.ts",
    "./queue": "./src/queue.ts",
    "./schema": "./src/schema/index.ts",
    "./system-events": "./src/system-events.ts",
    "./vm-state": "./src/vm-state.ts",
    "./vms": "./src/vms.ts",
    "./telegram-link-tokens": "./src/telegram-link-tokens.ts",
    "./web-sessions": "./src/web-sessions.ts"
  },
  "scripts": {
    "db:generate": "bun --env-file=../../.env.local --bun drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env.local --bun drizzle-kit migrate",
    "db:seed": "bun --env-file=../../.env.local src/seed.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@winston/domain": "workspace:*",
    "@winston/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4"
  }
}
