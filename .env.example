# Local development settings. setup.sh copies this to .env.local (gitignored),
# which is where your real values go. Every variable the code reads is listed here.

# Postgres from docker-compose.yml.
DATABASE_URL=postgres://winston:winston@127.0.0.1:5432/winston
# A separate database for tests, created automatically on first test run.
TEST_DATABASE_URL=postgres://winston:winston@127.0.0.1:5432/winston_test

# Local seed data (bun run db:seed): the user you'll develop as. The Telegram
# chat id is optional until the dev bot is set up.
SEED_EMAIL=
SEED_FIRST_NAME=
SEED_LAST_NAME=
SEED_TIMEZONE=America/New_York
SEED_TELEGRAM_CHAT_ID=

# Cloudflare Tunnel (bun run tunnel): gives the local api a public HTTPS URL for
# webhooks. See docs/local-dev.md to create your own tunnel.
TUNNEL_NAME=winston-dev
TUNNEL_ORIGIN_URL=http://127.0.0.1:3000

# Telegram dev bot: @RunWinstonDevBot, or your own from @BotFather. See
# docs/local-dev.md.
TELEGRAM_BOT_TOKEN=
# Telegram sends this with every webhook request. setup.sh generates it.
TELEGRAM_WEBHOOK_SECRET=
# The api's public URL (your tunnel's hostname); bun run telegram:webhook points
# the bot's webhook here.
API_PUBLIC_URL=https://dev.runwinston.com

# Google OAuth dev client ("Winston dev"), for sign-in (web) and connected
# accounts' access tokens (gateway, agents).
# See docs/runbooks/google-cloud.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Gmail push through the dev tunnel (optional), from `terraform output` in
# infra/gcp/dev (docs/runbooks/gcp-terraform.md). agents watches mail with the
# topic; api checks pushes against the audience and service account.
# GMAIL_PUSH_TOPIC=projects/winston-510100/topics/gmail-push-dev
# GMAIL_PUSH_AUDIENCE=https://dev.runwinston.com/webhooks/gmail
# GMAIL_PUSH_SERVICE_ACCOUNT=gmail-push-dev@winston-510100.iam.gserviceaccount.com
# Calendar push through the dev tunnel (optional): where agents asks Google
# Calendar channels to push. It must be HTTPS with a valid certificate, which
# the Cloudflare tunnel provides.
# CALENDAR_PUSH_URL=https://dev.runwinston.com/webhooks/calendar
# web service (optional; default shown): where the site is served. Builds the
# sign-in redirect URI; https makes cookies Secure.
# WEB_PUBLIC_URL=http://localhost:3002
# Where handoff live views connect (the gateway); production: wss://gateway.runwinston.com.
# GATEWAY_PUBLIC_URL=ws://localhost:3001
# web service (optional; default shown): the bot that Connect Telegram opens.
# TELEGRAM_BOT_USERNAME=RunWinstonDevBot

# OpenRouter key for model calls (a dev key, so dev spend is tracked separately).
OPENROUTER_API_KEY=

# The gateway's internal API secret (agents → gateway). setup.sh generates it.
GATEWAY_INTERNAL_SECRET=
# Signs the run tokens bash commands carry (agents signs, gateway verifies).
# setup.sh generates it.
RUN_TOKEN_SECRET=
# web (encrypts only), api, agents and gateway: seals connected accounts' tokens at rest.
# setup.sh generates it; changing it makes stored tokens unreadable. Production
# sets TOKEN_KMS_KEY_ID (the KMS tokens key) instead; set only one of the two.
TOKEN_ENCRYPTION_KEY=

# Logging for every service (optional). LOG_PRETTY forces human-readable (true)
# or JSON (false) output; unset, it's pretty only in a terminal.
# LOG_LEVEL=info
# LOG_PRETTY=

# gateway service (optional; defaults shown). Local VMs dial port 3001.
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=3001

# api service (optional; defaults shown). Keep the port in step with
# TUNNEL_ORIGIN_URL.
# API_HOST=127.0.0.1
# API_PORT=3000

# agents service (optional; defaults shown).
# WORKER_CONCURRENCY=4
# BACKGROUND_CONCURRENCY=16
# SHUTDOWN_TIMEOUT_MS=30000
# FRONT_WINDOW_MAX_TOKENS=150000
# FRONT_WINDOW_TARGET_TOKENS=100000
# GATEWAY_INTERNAL_URL=http://127.0.0.1:3001
# BLOB_DIR=<repo>/.data/blobs
# VM_PROVIDER=docker
# VM_IMAGE=winston-vm:local
# When VMs move onto a rebuilt image, as from-to hours in the user's time zone
# (default: any time locally, 3-5 on EC2).
# VM_ROLLOUT_HOURS=0-24
# VM_GATEWAY_URL=ws://host.docker.internal:3001
# Production only (set by the Services stack): BLOB_BUCKET, and with
# VM_PROVIDER=ec2, EC2_LAUNCH_TEMPLATE=winston-vm and EC2_SUBNET_IDS.
