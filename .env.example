# Local development settings. setup.sh copies this to .env.local (gitignored),
# which is where your real values go. Every variable the code reads is listed here.

# Postgres from docker-compose.yml.
DATABASE_URL=postgres://winston:winston@127.0.0.1:5432/winston
# A separate database for tests, created automatically on first test run.
TEST_DATABASE_URL=postgres://winston:winston@127.0.0.1:5432/winston_test

# Local seed data (bun run db:seed): the user you'll develop as. The Telegram
# chat id is optional until the dev bot is set up.
SEED_EMAIL=
SEED_FIRST_NAME=
SEED_LAST_NAME=
SEED_TIMEZONE=America/New_York
SEED_TELEGRAM_CHAT_ID=

# Cloudflare Tunnel (bun run tunnel): gives the local api a public HTTPS URL for
# webhooks. See docs/local-dev.md to create your own tunnel.
TUNNEL_NAME=winston-dev
TUNNEL_ORIGIN_URL=http://127.0.0.1:3000

# agents service (optional; defaults shown).
# LOG_LEVEL=info
# WORKER_CONCURRENCY=4
# SHUTDOWN_TIMEOUT_MS=30000
