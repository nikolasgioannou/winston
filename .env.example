# Copy to .env.local at the repository root.
# Use a development key for local model validation and conversation workers. Never commit real credentials.
# Leave empty when running checks that do not call external providers.
OPENROUTER_API_KEY=

# Development Telegram bot from the official @BotFather; never reuse the production bot.
# With OPENROUTER_API_KEY set, the API also runs conversation and reply-delivery workers.
# These values are server-only. Use bun run dev:telegram for local ingress.
TELEGRAM_BOT_TOKEN=
# Random webhook verification secret, separate from the bot token (A-Z, a-z, 0-9, _, -).
TELEGRAM_WEBHOOK_SECRET=

# Google OAuth clients for local development (server-only; never VITE_ variables).
# Sign-in callback: http://127.0.0.1:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001
WEB_ORIGIN=http://127.0.0.1:5173
# Generate a random secret of at least 32 characters. Set the exact allowed Google email.
BETTER_AUTH_SECRET=
OWNER_EMAIL=

# Separate Gmail/Calendar connection flow; implemented by the connector adapter.
# Connection callback: http://127.0.0.1:3001/callbacks/google/connections
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=

# Trusted services only: JSON map of key IDs to random 32-byte base64 encryption keys.
# Keep old keys during credential rotation and retain recovery keys with protected backups.
# Never copy these values onto Winston's computer or a desktop proxy.
CREDENTIAL_ACTIVE_KEY=
CREDENTIAL_KEYS=

# Local API host. Use HOST=0.0.0.0 in the deployed container.
HOST=127.0.0.1
PORT=3001
SHUTDOWN_TIMEOUT_MS=10000

# Database URLs stay separate: pooled application traffic and direct migrations/LISTEN.
# Fill with local development credentials; never use production URLs locally.
DATABASE_URL=
DIRECT_DATABASE_URL=
