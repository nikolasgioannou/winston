{
  "name": "@winston/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./background": "./src/background/step.ts",
    "./background-runtime": "./src/background/runtime.ts",
    "./conversation": "./src/conversation/loop.ts"
  },
  "scripts": {
    "build": "bun build ./src/main.ts --target=bun --env=disable --outdir=dist --external '@winston/adapters/*'",
    "dev": "bun --watch src/main.ts",
    "start": "bun dist/main.js",
    "test:unit": "bun test ./tests",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@winston/adapters": "workspace:*",
    "@winston/contracts": "workspace:*",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@winston/config": "workspace:*",
    "typescript": "6.0.3"
  }
}
