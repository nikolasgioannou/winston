{
  "name": "@winston/agents",
  "private": true,
  "type": "module",
  "scripts": {
    "eval:export": "bun src/evals/export.ts",
    "eval:replay": "bun --env-file=../../.env.local src/evals/replay.ts",
    "model:smoke": "bun --env-file=../../.env.local src/model/smoke.ts",
    "start": "bun --env-file=../../.env.local src/main.ts",
    "task:start": "bun --env-file=../../.env.local src/background/start-cli.ts",
    "typecheck": "tsc",
    "vm:provision": "bun --env-file=../../.env.local src/vm/seeded.ts provision",
    "vm:reset": "bun --env-file=../../.env.local src/vm/seeded.ts reset",
    "vm:shell": "bun --env-file=../../.env.local src/vm/seeded.ts shell"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1144.0",
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/client-ses": "3.1144.0",
    "@aws-sdk/client-ssm": "3.1144.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@winston/blobs": "workspace:*",
    "@winston/connectors": "workspace:*",
    "@winston/db": "workspace:*",
    "@winston/domain": "workspace:*",
    "@winston/prompts": "workspace:*",
    "@winston/shared": "workspace:*",
    "ai": "7.0.118",
    "drizzle-orm": "1.0.0-rc.4",
    "grammy": "1.46.0",
    "zod": "4.6.5"
  }
}
